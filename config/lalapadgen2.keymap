#include <input/processors.dtsi>
#include <dt-bindings/zmk/zip_dynamic_scale.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT_LAYER   0
#define SECONDARY_LAYER 1
#define TERTIARY_LAYER  2
#define SYSTEM_LAYER    3
#define FUNCTION_LAYER  4

// OS設定を日本語キーボードのまま使用するための変換定義
#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角
#define JP_HENKAN       INT4              // 変換
#define JP_MUHEN        INT5              // 無変換

&mt {
    tapping-term-ms = <200>;
    quick-tap-ms = <150>;
    flavor = "balanced";
};

&lt {
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        zip_dyn_scale: zip_dyn_scale {
            compatible = "zmk,behavior-zip-dynamic-scale";
            #binding-cells = <2>;
        };

        zip_dyn_scale_set: zip_dyn_scale_set {
            compatible = "zmk,behavior-zip-dynamic-scale-set";
            #binding-cells = <2>;
        };

        mt2: mod_tap2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        tap_dance_layer_1and2: tap_dance_layer_1and2 {
            compatible = "zmk,behavior-tap-dance";
            label = "td_mo12";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&mo 2>;
        };

        hmrr: hmr_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <35 34 33 32 31 30 20 21 22 23 24 14 13 12 11 10 0 1 2 3 4>;
            hold-trigger-on-release;
            require-prior-idle-ms = <150>;
        };

        hmrl: hmr_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <41 40 39 38 37 36 29 28 27 26 25 19 18 17 16 15 5 6 7 8 9>;
            hold-trigger-on-release;
            require-prior-idle-ms = <150>;
        };
    };

    combos {
        compatible = "zmk,combos";
/*
        CONBO_ESC {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        COMBO_TAB {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };
*/        
        combo_JP_EISU {
            timeout-ms = <50>;
            key-positions = <12 13>;
            bindings = <&kp JP_EISU>;
        };
        
        combo_JP_HANZEN {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp JP_HANZEN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT_LAYER {
            display-name = "Default";
            bindings = <
&kp Q       &kp W               &kp E           &kp R           &kp T                                               &kp Y           &kp U               &kp I           &kp O           &kp P
&kp A       &kp S               &hmrl LSHIFT D  &hmrl LCTRL F   &hmrl LALT G                                        &hmrr RALT H    &hmrr RCTRL J       &kp K           &hmrr RGUI L    &kp SEMICOLON
&kp Z       &kp X               &lt 4 C         &kp V           &kp B                                               &kp N           &kp M               &lt 4 COMMA     &kp DOT         &kp SLASH
&lt 3 ESC   &mt LGUI LS(TAB)    &kp TAB         &lt 2 JP_KANA   &lt 1 SPACE     &kp JP_EISU             &kp DEL     &kp BACKSPACE   &mt RSHIFT ENTER    &kp JP_MUHEN    &kp JP_HENKAN   &kp DEL

            &none               &kp RIGHT       &kp DOWN        &kp LEFT        &kp UP                  &kp UP      &kp LEFT        &kp DOWN            &kp RIGHT       &none
&mkp LCLK   &mkp RCLK           &mkp MCLK                                                                                                               &mkp LCLK       &mkp RCLK       &mkp MCLK
&mkp MB4    &mkp MB5            &kp LG(TAB)     &kp LG(D)       &kp LCTRL                                           &mkp MB4        &mkp MB5            &kp LG(TAB)     &kp LG(D)       &kp LCTRL
            >;
        };

        SECONDARY_LAYER {
            display-name = "number_layer";
            bindings = <
&none               &none               &kp LA(DOWN)    &kp LA(UP)  &none                                   &kp COMMA           &kp N7              &kp N8    &kp N9      &kp SLASH
&none               &kp LEFT            &kp UP          &kp RIGHT   &none                                   &kp JP_COLON        &kp N4              &kp N5    &kp N6      &kp JP_ASTERISK
&none               &none               &kp DOWN        &none       &none                                   &kp JP_EQUAL        &kp N1              &kp N2    &kp N3      &kp MINUS
&none               &none               &none           &trans      &trans   &trans             &trans   &kp N0              &trans              &kp N0    &kp DOT     &kp JP_PLUS

                    &trans              &trans          &trans      &trans   &trans             &trans      &trans              &trans              &trans    &trans
&trans              &trans              &trans                                                                                                      &trans    &trans      &trans
&kp LC(LG(LEFT))    &kp LC(LG(RIGHT))   &trans          &trans      &trans                                  &kp LC(LG(LEFT))    &kp LC(LG(RIGHT))   &trans    &trans      &trans
            >;
        };

        TERTIARY_LAYER {
            display-name = "mark_layer";
            bindings = <
&kp EXCLAMATION     &kp JP_DQUOTE       &kp HASH            &kp DOLLAR      &kp PERCENT                                         &kp JP_AMPERSAND    &kp JP_QUOTE    &kp JP_LPAREN       &kp JP_RPAREN       &kp MINUS
&kp JP_COLON        &kp JP_QUOTE        &kp EXCLAMATION     &kp SLASH       &kp JP_PLUS                                         &kp JP_PIPE         &kp JP_AT       &kp JP_LBRACKET     &kp JP_RBRACKET     &kp JP_UNDERSCORE
&kp SEMICOLON       &kp JP_BACKQUOTE    &kp QUESTION        &kp INT_RO      &kp JP_ASTERISK                                     &kp JP_EQUAL        &kp JP_YEN      &kp LESS_THAN       &kp GREATER_THAN    &kp JP_TILDE
&none               &none               &none               &trans          &trans              &trans              &trans      &trans              &trans          &kp JP_LBRACE       &kp JP_RBRACE       &kp JP_CARET

                    &trans              &trans              &trans          &trans              &trans              &trans      &trans              &trans          &trans              &trans
&trans              &trans              &trans                                                                                                      &trans          &trans              &trans
&trans              &trans              &trans              &trans          &trans                                              &trans              &trans          &trans              &trans              &trans
            >;
        };

        SYSTEM_LAYER {
            display-name = "system_layer";
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4   &kp F5                   &out OUT_TOG                   &bt BT_SEL 0                   &bt BT_SEL 1                   &bt BT_SEL 2                   &bt BT_SEL 3
&kp F6   &kp F7   &kp F8   &kp F9   &kp F10                  &sys_reset                     &bootloader                    &bt BT_CLR                     &bt BT_CLR_ALL                 &trans
&kp F11  &kp F12  &kp F13  &kp F14  &kp F15                  &zip_dyn_scale ZDS_XY ZDS_INC  &zip_dyn_scale ZDS_XY ZDS_DEC  &zip_dyn_scale ZDS_SC ZDS_INC  &zip_dyn_scale ZDS_SC ZDS_DEC  &zip_dyn_scale ZDS_ALL ZDS_RST
&trans   &trans   &trans   &trans   &trans   &trans  &trans  &trans                         &trans                         &trans                         &trans                         &trans

         &trans   &trans   &trans   &trans   &trans  &trans  &trans                         &trans                         &trans                         &trans
&trans   &trans   &trans                                                                                                   &trans                         &trans                         &trans
&trans   &trans   &trans   &trans   &trans                   &trans                         &trans                         &trans                         &trans                         &trans
            >;
        };

        FUNCTION_LAYER {
            display-name = "function_layer";
            bindings = <
&kp F1   &kp F2             &kp F3          &kp F4      &kp F5                              &kp F6      &kp F7      &kp F8      &kp F9      &kp F12
&none    &kp HOME           &kp PG_UP       &kp END     &none                               &none       &trans      &trans      &trans      &kp RC(RS(ESC))
&none    &none              &kp PG_DN       &none       &none                               &none       &trans      &trans      &trans      &kp RC(RA(DEL))
&none    &kp LS(PSCRN)      &kp PSCRN       &trans      &trans   &trans             &trans  &trans      &trans      &trans      &trans      &kp RG(L)

         &trans             &trans          &trans      &trans   &trans             &trans  &trans      &trans      &trans      &trans
&trans   &trans             &trans                                                                                  &trans      &trans      &trans
&trans   &trans             &trans          &trans      &trans                              &trans      &trans      &trans      &trans      &trans
            >;
        };
    };
};
